{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pricediscussion",
  "main": "custom-worker.ts",
  "compatibility_date": "2025-08-21",
  "compatibility_flags": ["nodejs_compat"],
  // ONE every-minute schedule; custom-worker.ts fires BOTH sweeps on it:
  //   • To-Do reminder sweep (users pick due times to the minute).
  //   • indexer reconcile backstop (replays webhook misses; idempotent).
  // Cloudflare cron floors at 1 minute — this is the tightest cadence. The
  // reconcile's per-run work is a handful of ≤10-block log reads, well inside
  // the RPC free tier at 1-min (Brendon, 2026-07-11: reconcile 2min → 1min).
  "triggers": {
    "crons": ["* * * * *"]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Next's data/route cache (the timed-cache API routes: stats 60s, price 10s,
  // search 60s…) — same revalidate behaviour the app had on Vercel.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "b332595e9f1e40279c5e7f9c1f1f2fc0"
    }
  ],
  // Stored Artwork previews (the Cloudflare stand-in for Arweave). Per-mint the
  // app pins {slug}/{id}.png here; /preview/* serves them back from this binding,
  // so no public bucket and no token are needed. Activates on deploy.
  "r2_buckets": [
    {
      "binding": "PD_ART_PREVIEWS",
      "bucket_name": "pd-art-previews"
    }
  ]
}
