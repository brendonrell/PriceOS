{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git remote:*)",
      "Bash(git push:*)",
      "Bash(git clone:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run start:*)",
      "Bash(npx tsc:*)",
      "Bash(npx next:*)",
      "Bash(npx prettier:*)",
      "Bash(npx eslint:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(jq:*)",
      "Bash(echo:*)",
      "Bash(pwd:*)",
      "Bash(wc:*)",
      "Bash(tree:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)"
    ],
    "ask": [
      "Bash(rm:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"=== PriceOS session start ===\"; echo \"branch: $(git rev-parse --abbrev-ref HEAD 2>/dev/null)\"; echo \"head:   $(git log --oneline -1 2>/dev/null)\"; echo \"tree:   $(test -z \"$(git status --porcelain 2>/dev/null)\" && echo clean || echo DIRTY)\"; npm install --no-audit --no-fund >/dev/null 2>&1 && echo \"deps:   installed\" || echo \"deps:   npm install FAILED (run manually)\"; echo \"Read CLAUDE.md before acting. Ship gates: merge / on-chain deploy / prod data are Brendon's taps.\""
          }
        ]
      }
    ]
  }
}
